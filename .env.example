# ==============================================================================
# RCB Jewellery & Pawn Shop - Environment Configuration Template
# Copy this file to .env and provide your specific environment values.
# NEVER commit .env to version control!
# ==============================================================================

# Supabase Client Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Payment Gateway
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Real-Time Bullion Metal Rates (GoldAPI.io - Optional for Live Rates)
VITE_GOLD_API_KEY=your_goldapi_key_here

# PostgreSQL Direct Connection (For backend scripts & migrations only)
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=db.your-project-id.supabase.co
DB_PORT=5432
DB_NAME=postgres
