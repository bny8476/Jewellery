{
  "name": "jewelry-pawnshop-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/server.js",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "test": "vitest run src/routes/paymentSecurityAndAuth.test.ts",
    "update:rates": "node scripts/update-metal-rates.cjs",
    "setup:db": "node scripts/setup-pawnshop-db.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.7",
    "esbuild": "^0.21.5",
    "pg": "^8.16.3",
    "razorpay": "^2.9.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vercel/node": "^3.0.0",
    "typescript": "^5.5.3"
  }
}
