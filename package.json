{
  "name": "jewelry-pawn-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev-runner.cjs",
    "dev:all": "node scripts/dev-runner.cjs",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:backend": "npm --workspace=backend run dev",
    "start:backend": "npm --workspace=backend run start",
    "build": "npm --workspace=frontend run build && npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "build:backend": "npm --workspace=backend run build",
    "preview": "npm --workspace=frontend run preview",
    "test": "npm --workspace=frontend run test",
    "test:frontend": "npm --workspace=frontend run test",
    "lint": "npm --workspace=frontend run lint",
    "update:rates": "npm --workspace=backend run update:rates"
  },
  "dependencies": {
    "@number-flow/react": "^0.5.5",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/supabase-js": "^2.39.7",
    "framer-motion": "^12.29.2",
    "gsap": "^3.15.0",
    "i18next": "^23.7.16",
    "i18next-browser-languagedetector": "^7.2.0",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.344.0",
    "motion": "^12.0.0",
    "pg": "^8.16.3",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.22.2",
    "react-toastify": "^10.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.11"
  }
}
